<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="CyberFeedForward.MusicaMaestro.Views.FirstRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Welcome to Musica Maestro"
    DefaultButton="Primary"
    PrimaryButtonText="OK"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Customize your experience before you begin." TextWrapping="Wrap" />

            <ComboBox
                x:Name="ThemeModeComboBox"
                Header="Theme"
                SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="System default" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>

            <ToggleSwitch
                x:Name="NotificationsToggle"
                Header="Notifications"
                IsOn="{Binding AreNotificationsEnabled, Mode=TwoWay}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SoundClipsPathTextBox"
                    Grid.Column="0"
                    AutomationProperties.Name="SoundClips folder path"
                    Header="SoundClips folder"
                    IsReadOnly="True"
                    Text="{Binding SoundClipsPath, Mode=OneWay}" />

                <Button
                    x:Name="BrowseSoundClipsButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Browse for SoundClips folder"
                    Click="BrowseSoundClipsButton_Click"
                    Content="Browse..."
                    VerticalAlignment="Bottom" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
