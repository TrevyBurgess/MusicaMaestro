<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CyberFeedForward.MusicaMaestro.Views.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,16" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Help" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Connecting to an AI model" />

            <TextBlock
                Text="The Music Synthesis page can query any OpenAI-compatible chat completion endpoint. You can run a model locally on your machine, or use an online service."
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Local setup" />
            <StackPanel Spacing="8">
                <TextBlock
                    Text="1. Install LM Studio, Ollama, or another tool that exposes an OpenAI-compatible server."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="2. Start the local server. The default endpoint in Settings is http://localhost:1234/v1/chat/completions (LM Studio)."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="3. In Settings, set AI provider to Local, leave the API key blank, and enter the model name if your server requires one."
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Online setup" />
            <StackPanel Spacing="8">
                <TextBlock
                    Text="1. Sign up with an online provider such as OpenAI, Azure OpenAI, or another OpenAI-compatible API."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="2. In Settings, set AI provider to Online."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="3. Enter the endpoint, for example https://api.openai.com/v1/chat/completions."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="4. Enter your API key and the model name, for example gpt-4."
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
