<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyMusicMaestro.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyMusicMaestro.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
        <StackPanel Grid.Row="1" Spacing="12">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="MyMusicMaestro" />
            <TextBlock Text="A modern WinUI 3 desktop application for creating and managing music projects." TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
